# Пример настроек без рабочих секретов.
# Studio/файловый pipeline: скопируйте в services/content-service/.env
# и заполните LLM_API_KEY; корневой .env Studio автоматически не читает.
# Сетевой Compose: скопируйте в корневой .env; параметры ниже относятся
# к разным процессам, Compose передаёт каждому только свой набор.

# content-service
# Токен Hugging Face с разрешением Inference Providers
LLM_API_KEY=your-hf-token
LLM_API_TIMEOUT=180
LLM_MODEL=Qwen/Qwen3.8-27B:deepinfra
LLM_BASE_URL=https://router.huggingface.co/v1
LLM_TEMPERATURE=0.2
LLM_REASONING_EFFORT=none
LLM_MAX_TOKENS=8192
LLM_RESPONSE_RETRIES=2
CONTENT_VALIDATION_RETRIES=2
# Планировщик Studio и быстрый пакетный режим предыдущего CLI/web
LLM_FAST_MODEL=Qwen/Qwen3.8-27B:deepinfra
LLM_FAST_REPAIR_MODEL=Qwen/Qwen3.8-27B:deepinfra
LLM_FAST_API_TIMEOUT=180
FAST_GENERATION_TIMEOUT=240
LOG_LEVEL=INFO
# Иллюстрации Studio: текущая роль image_illustrator из agents/designer.toml.
# Для штатного HF/fal пустой IMAGE_API_KEY означает использование LLM_API_KEY.
# Сам endpoint не включает автоиллюстрации: см. IMAGE_GENERATION_ENABLED ниже.
IMAGE_API_URL=https://router.huggingface.co/fal-ai/fal-ai/z-image/turbo
IMAGE_API_KEY=
IMAGE_MODEL=Tongyi-MAI/Z-Image-Turbo
IMAGE_API_TIMEOUT=90

# Постоянная библиотека предыдущего exposlides.web (оба параметра вместе).
# Studio хранит задания отдельно; каталог задаётся аргументом --data-dir.
# Передайте их через export или systemd Environment; content-service/.env
# не загружается веб-сервером. Если оба не заданы, используется временный режим.
# EXPOSLIDES_FILE_SERVICE=127.0.0.1:50051
# EXPOSLIDES_DATA_DIR=/absolute/path/to/exposlides-library

# Сетевые сервисы; для запуска Studio этот раздел не нужен.
# Ниже демонстрационные локальные реквизиты, замените перед внешним размещением.
# file-service
## minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=files
MAX_UPLOAD_SIZE=52428800
FILE_SERVICE_PORT=50051
## postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=files
# Compose собирает DATABASE_URL из POSTGRES_* самостоятельно. При прямом
# запуске file-service передайте DATABASE_URL через окружение процесса:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/files

# parsing-service
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
# При прямом запуске у каждого worker своя группа; общий override смешивает их.
# KAFKA_GROUP_ID=parser-service  # для parser
# KAFKA_GROUP_ID=content-service # для content
# KAFKA_GROUP_ID=builder-service # для builder
KAFKA_TOPIC_TASK_CREATED=task.created
KAFKA_TOPIC_TASK_PARSED=task.parsed
KAFKA_TOPIC_TASK_FAILED=task.failed
FILE_SERVICE_GRPC_HOST=file-service
FILE_SERVICE_GRPC_PORT=50051
PARSER_SERVICE_PORT=50052

# content-service
CONTENT_SERVICE_PORT=50053
KAFKA_TOPIC_TASK_CONTENT_RETRY=task.content_retry
LLM_STUB_MODE=false

# gateway-service
GATEWAY_SERVICE_PORT=1000
GATEWAY_PORT=1000
REDIS_URL=redis://redis:6379/0
REDIS_SESSION_TTL=2592000
GATEWAY_KAFKA_GROUP_ID=gateway-service
KAFKA_TOPIC_TASK_CONTENT_READY=task.content_ready
KAFKA_TOPIC_TASK_BUILT=task.built
COOKIE_NAME=exposlides_sid
COOKIE_MAX_AGE=2592000
# Имена для Compose; при прямом запуске gateway используйте
# ALLOWED_ORIGINS и COOKIE_SECURE соответственно. Origin задаётся JSON-массивом.
GATEWAY_ALLOWED_ORIGINS=[]
GATEWAY_COOKIE_SECURE=false

# Автоиллюстрации Studio: передайте IMAGE_GENERATION_ENABLED через export
# или systemd Environment в процесс Studio. Строка в content-service/.env
# сама по себе режим не включает. Следующие лимиты IMAGE_GENERATION_TIMEOUT,
# IMAGE_CONCURRENCY и IMAGE_MAX_COUNT относятся к предыдущему CLI/web.
# IMAGE_API_TIMEOUT выше применяется к обоим адаптерам.
IMAGE_GENERATION_ENABLED=true
IMAGE_GENERATION_TIMEOUT=120
IMAGE_CONCURRENCY=2
IMAGE_MAX_COUNT=20
# builder-service
PDF_CONVERT_TIMEOUT=120
