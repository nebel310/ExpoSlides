# content-service
LLM_API_KEY=your-api-key
LLM_API_TIMEOUT=180
LLM_MODEL=GigaChat-2-Max
LLM_BASE_URL=https://api.giga.chat/v1
LLM_SCOPE=GIGACHAT_API_PERS
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=8192
LLM_RESPONSE_RETRIES=2
CONTENT_VALIDATION_RETRIES=2
LOG_LEVEL=INFO

# file-service
## minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=files
MAX_UPLOAD_SIZE=52428800
FILE_SERVICE_PORT=50051
## postgresql
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=files